TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
DEFAULT_LANGUAGE=zh
MAX_EPISODE_DURATION_MINUTES=180
MAX_DOWNLOAD_MB=500
CHUNK_SECONDS=600
DATA_DIR=data
TRANSCRIPTION_HINTS=
# Optional informational estimate only; leave empty to disable.
ESTIMATED_COST_PER_MINUTE_USD=

# Language learning (preferences can also be changed through Telegram commands)
STUDY_ENABLED=true
TARGET_LANGUAGE=zh
NATIVE_LANGUAGE=ru
LEARNER_LEVEL=HSK3
OPENAI_STUDY_MODEL=gpt-5.4-mini
VOCAB_TARGET_COUNT=20
MANDARIN_MOSAIC_SENTENCE_TARGET=20
STUDY_CHUNK_CHARS=3000
HANLY_CSV_COLUMNS=Chinese,Pinyin,Russian,Example,ExampleTranslation,Tags
# Optional: set all three together to override known study-model pricing.
STUDY_INPUT_USD_PER_MILLION=
STUDY_CACHED_INPUT_USD_PER_MILLION=
STUDY_OUTPUT_USD_PER_MILLION=

# Optional /mosaic upload. Both are secrets; leave both empty to disable.
MANDARIN_MOSAIC_REFRESH_TOKEN=
MANDARIN_MOSAIC_REFRESH_TOKEN_ID=

# Interactive Reader Mini App. READER_PUBLIC_URL is the public HTTPS address of the
# reverse proxy in front of READER_HOST:READER_PORT; without it the bot shows no button.
READER_ENABLED=true
READER_PUBLIC_URL=
READER_HOST=127.0.0.1
READER_PORT=8081
# Local development only: accepts browser requests that carry no Telegram init data.
READER_DEV_MODE=false

# Optional external Hanly auth file (directory must be writable for rotation).
HANLY_AUTH_FILE=
# Upload Chinese study results to configured Hanly then Mosaic services.
STUDY_AUTO_UPLOAD=true
# Host directory used only by the optional docker-compose.hanly.yml override.
HANLY_AUTH_DIR=
