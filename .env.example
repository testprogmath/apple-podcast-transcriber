TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
DEFAULT_LANGUAGE=zh
MAX_EPISODE_DURATION_MINUTES=180
MAX_DOWNLOAD_MB=500
CHUNK_SECONDS=600
DATA_DIR=data
TRANSCRIPTION_HINTS=
# Optional informational estimate only; leave empty to disable.
ESTIMATED_COST_PER_MINUTE_USD=

# Language learning (preferences can also be changed through Telegram commands)
STUDY_ENABLED=true
TARGET_LANGUAGE=zh
NATIVE_LANGUAGE=ru
LEARNER_LEVEL=HSK3
OPENAI_STUDY_MODEL=gpt-5.4-mini
VOCAB_TARGET_COUNT=20
MANDARIN_MOSAIC_SENTENCE_TARGET=20
STUDY_CHUNK_CHARS=3000
HANLY_CSV_COLUMNS=Chinese,Pinyin,Russian,Example,ExampleTranslation,Tags
# Optional: set all three together to override known study-model pricing.
STUDY_INPUT_USD_PER_MILLION=
STUDY_CACHED_INPUT_USD_PER_MILLION=
STUDY_OUTPUT_USD_PER_MILLION=
